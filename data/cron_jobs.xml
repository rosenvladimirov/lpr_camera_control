<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_mqtt_listener_health_check" model="ir.cron">
            <field name="name">MQTT Listener Health Check</field>
            <field name="model_id" ref="model_mqtt_listener_service"/>
            <field name="state">code</field>
            <field name="code">
                # Проверяваме дали MQTT слушалката работи
                status = model.get_listener_status()
                if not status['running']:
                    # Опитваме се да я рестартираме
                    model.start_mqtt_listener()
            </field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="active">True</field>
        </record>
    </data>
</odoo>