<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View -->
    <record id="onvif_camera_event_tree_view" model="ir.ui.view">
        <field name="name">ONVIF Camera Events Tree</field>
        <field name="model">onvif.camera.event</field>
        <field name="arch" type="xml">
            <list string="ONVIF Camera Events" default_order="create_date desc">
                <field name="name"/>
                <field name="camera_id"/>
                <field name="event_type"/>
                <field name="event_time"/>
                <field name="processed" widget="boolean_toggle"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="onvif_camera_event_form_view" model="ir.ui.view">
        <field name="name">ONVIF Camera Event Form</field>
        <field name="model">onvif.camera.event</field>
        <field name="arch" type="xml">
            <form string="ONVIF Camera Event">
                <header>
                    <button name="action_mark_processed" type="object"
                            string="Маркирай като обработено"
                            class="btn-primary"
                            invisible="processed"/>
                    <field name="processed" widget="statusbar"
                           statusbar_visible="False,True"/>
                </header>
                <sheet>
                    <group>
                        <group string="Основна информация">
                            <field name="name" readonly="1"/>
                            <field name="camera_id"/>
                            <field name="event_type"/>
                            <field name="event_time"/>
                        </group>
                        <group string="Статус">
                            <field name="processed"/>
                            <field name="processing_notes"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Сурови данни">
                            <field name="raw_data" widget="text" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="onvif_camera_event_search_view" model="ir.ui.view">
        <field name="name">ONVIF Camera Events Search</field>
        <field name="model">onvif.camera.event</field>
        <field name="arch" type="xml">
            <search string="Търсене на ONVIF събития">
                <field name="name"/>
                <field name="camera_id"/>
                <field name="event_type"/>

                <filter name="unprocessed" string="Необработени"
                        domain="[('processed', '=', False)]"/>
                <filter name="processed" string="Обработени"
                        domain="[('processed', '=', True)]"/>

                <separator/>
                <filter name="today" string="Днес"
                        domain="[('event_time', '&gt;=', datetime.datetime.now().replace(hour=0, minute=0, second=0))]"/>
                <filter name="this_week" string="Тази седмица"
                        domain="[('event_time', '&gt;=', (context_today() - datetime.timedelta(days=context_today().weekday())).strftime('%Y-%m-%d'))]"/>

                <group expand="0" string="Групиране">
                    <filter string="Камера" name="group_camera" context="{'group_by': 'camera_id'}"/>
                    <filter string="Тип събитие" name="group_event_type" context="{'group_by': 'event_type'}"/>
                    <filter string="Дата" name="group_date" context="{'group_by': 'event_time:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="onvif_camera_event_kanban_view" model="ir.ui.view">
        <field name="name">ONVIF Camera Events Kanban</field>
        <field name="model">onvif.camera.event</field>
        <field name="arch" type="xml">
            <kanban default_group_by="event_type" quick_create="false">
                <field name="name"/>
                <field name="camera_id"/>
                <field name="event_type"/>
                <field name="event_time"/>
                <field name="processed"/>
                <field name="color" invisible="1"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click
                             #{record.processed.raw_value ? 'oe_kanban_color_4' : 'oe_kanban_color_2'}">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                    <div class="o_dropdown_kanban dropdown" groups="base.group_user">
                                        <a role="button" class="dropdown-toggle o-no-caret btn" data-toggle="dropdown" href="#" aria-label="Dropdown menu" title="Dropdown menu">
                                            <span class="fa fa-ellipsis-v"/>
                                        </a>
                                        <div class="dropdown-menu" role="menu">
                                            <a t-if="!record.processed.raw_value" role="menuitem" type="object" name="action_mark_processed" class="dropdown-item">Маркирай като обработено</a>
                                            <a role="menuitem" type="edit" class="dropdown-item">Редактирай</a>
                                            <a role="menuitem" type="delete" class="dropdown-item">Изтрий</a>
                                        </div>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div>
                                        <i class="fa fa-video-camera"/> <field name="camera_id"/>
                                    </div>
                                    <div>
                                        <i class="fa fa-clock-o"/> <field name="event_time" widget="datetime"/>
                                    </div>
                                    <div t-if="!record.processed.raw_value" class="text-warning">
                                        <i class="fa fa-exclamation-triangle"/> Необработено
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Calendar View -->
    <record id="onvif_camera_event_calendar_view" model="ir.ui.view">
        <field name="name">ONVIF Camera Events Calendar</field>
        <field name="model">onvif.camera.event</field>
        <field name="arch" type="xml">
            <calendar string="ONVIF Camera Events"
                      date_start="event_time"
                      color="camera_id"
                      event_open_popup="true">
                <field name="name"/>
                <field name="camera_id"/>
                <field name="event_type"/>
                <field name="processed"/>
            </calendar>
        </field>
    </record>

    <!-- Pivot View -->
    <record id="onvif_camera_event_pivot_view" model="ir.ui.view">
        <field name="name">ONVIF Camera Events Pivot</field>
        <field name="model">onvif.camera.event</field>
        <field name="arch" type="xml">
            <pivot string="ONVIF Camera Events Analysis">
                <field name="event_time" type="row" interval="day"/>
                <field name="camera_id" type="col"/>
                <field name="event_type" type="col"/>
            </pivot>
        </field>
    </record>

    <!-- Graph View -->
    <record id="onvif_camera_event_graph_view" model="ir.ui.view">
        <field name="name">ONVIF Camera Events Graph</field>
        <field name="model">onvif.camera.event</field>
        <field name="arch" type="xml">
            <graph string="ONVIF Camera Events" type="bar">
                <field name="event_time" type="row" interval="day"/>
                <field name="camera_id" type="col"/>
            </graph>
        </field>
    </record>

    <!-- Action -->
    <record id="onvif_camera_event_action" model="ir.actions.act_window">
        <field name="name">ONVIF Camera Events</field>
        <field name="res_model">onvif.camera.event</field>
        <field name="view_mode">list,form,kanban,calendar,pivot,graph</field>
        <field name="context">{
            'search_default_today': 1,
            'search_default_unprocessed': 1
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Няма записани ONVIF camera събития!
            </p>
            <p>
                ONVIF camera събитията се създават автоматично когато камерите засекат движение или други събития.
            </p>
        </field>
    </record>

    <!-- Menu Items -->
    <menuitem id="onvif_camera_main_menu"
              name="ONVIF Камери"
              web_icon="lpr_camera_control,static/description/icon.png"
              sequence="100"/>

    <menuitem id="onvif_camera_events_menu"
              name="Camera Wydarzenia"
              parent="onvif_camera_main_menu"
              action="onvif_camera_event_action"
              sequence="10"/>

</odoo>